SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Use sqlite locally by leaving DATABASE_ENGINE empty or set PostgreSQL values.
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=postres
DATABASE_USER=postres_user
DATABASE_PASSWORD=postres_password
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Alternative:
# DATABASE_URL=postgres://postres_user:postres_password@localhost:5432/postres

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=no-reply@postres.local
